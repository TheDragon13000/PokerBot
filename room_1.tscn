[sub_resource type="TileSet" id="TileSet_esuk2"]
sources/0 = SubResource("TileSetAtlasSource_c8u8o")

[sub_resource type="GDScript" id="GDScript_4h8hh"]
script/source = "extends Node

@export var cameras: Array[Camera2D] = []       # index 0 = room0, 1 = room1, 2 = room2, etc.
@export var spawn_points: Array[Node2D] = []    # same order as cameras

var current_room: int = 1
var player: Node2D

func _ready() -> void:
	player = get_tree().get_first_node_in_group(\"player_group\")
	if cameras.size() > 0 and cameras[0]:
		cameras[0].make_current()

func go_to_room(room_index: int) -> void:
	current_room = room_index
	if room_index < cameras.size() and cameras[room_index]:
		cameras[room_index].make_current()
	else:
		print(\"Room \", room_index, \" has no camera assigned yet.\")

	if player and room_index < spawn_points.size() and spawn_points[room_index]:
		player.global_position = spawn_points[room_index].global_position
	else:
		print(\"Room \", room_index, \" has no spawn point assigned yet.\")
"

[sub_resource type="GDScript" id="GDScript_vc1db"]
script/source = "
extends Camera2D

@export var min_x: float = -1000.0
@export var max_x: float = 1000.0

var player: Node2D
var fixed_y: float

func _ready() -> void:
	player = get_tree().get_first_node_in_group(\"player_group\")
	fixed_y = global_position.y   # remembers whatever Y the camera starts at

func _process(_delta: float) -> void:
	if player:
		var target_x = clamp(player.global_position.x, min_x, max_x)
		global_position = Vector2(target_x, fixed_y)
"

